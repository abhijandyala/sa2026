{
  "name": "fieldback-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A.C.R.E frontend: compare winter crop plans against past springs recorded by NASA (NASA Space Apps 2026, Field Shift, Charlotte).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sample": "node scripts/make-sample.mjs",
    "data": "node scripts/fetch-backend.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "5.1.1",
    "@react-three/fiber": "8.17.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
